# ==============================================================================
# IBAP Payment Operations Agent — Environment Variable Configuration
# Phase 2: Supabase PostgreSQL Database & Auth Setup
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Connection (Frontend & Public APIs)
# ------------------------------------------------------------------------------
# URL of your Supabase project instance (local CLI default: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anonymous API Key (safe to expose in client browsers; enforced by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# 2. Supabase Backend / Administrative Access
# ------------------------------------------------------------------------------
# Service Role Secret Key (NEVER expose to frontend; bypasses RLS for system operations)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Direct Database Connection String (for Prisma or direct psql scripts)
# Example: postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ------------------------------------------------------------------------------
# 3. Backend Express Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
