# ==============================================================================
# SUPABASE ENVIRONMENT CONFIGURATION GUIDE
# ==============================================================================
# Copy this file to `.env.local` inside the `frontend` folder for local development:
#   cp .env.example .env.local

# 1. NEXT_PUBLIC_SUPABASE_URL
# Public Supabase URL for your project instance. Accessible in browser and server components.
# Obtain from Supabase Dashboard -> Project Settings -> API -> Project URL
# Example: https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. NEXT_PUBLIC_SUPABASE_ANON_KEY
# Public Anonymous API Key. Safe for browser code. Restricted by Row Level Security (RLS).
# Obtain from Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 3. SUPABASE_SERVICE_ROLE_KEY
# Private Service Role API Key. DO NOT EXPOSE TO THE BROWSER!
# Bypasses Row Level Security (RLS). Used only for backend tasks or admin APIs.
# Obtain from Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role / secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here
